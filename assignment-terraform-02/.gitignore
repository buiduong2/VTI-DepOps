cat > .gitignore <<'EOF'
# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan

# Sensitive credentials
*.pem
*.key
.env
.env.*

# Local Terraform CLI configuration
.terraformrc
terraform.rc
EOF