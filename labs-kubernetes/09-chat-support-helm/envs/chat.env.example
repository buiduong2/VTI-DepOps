# FRONTEND / CORS
# ==========================================
CHAT_UI_ORIGIN=https://chat.local.test

## TImezone
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Ho_Chi_Minh # fix lỗi server sử dụng LocalDateTime.now() thay vì Instant 
